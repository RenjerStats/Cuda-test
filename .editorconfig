root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_size = 2

[CMakeLists.txt]
indent_size = 2

[*.{cmake,cpp,cxx,cc,h,hpp,cuh,cu}]
indent_size = 4
